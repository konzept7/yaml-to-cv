<!DOCTYPE html>
<html>

<head>
    <meta charset="utf-8">
    <title>CV {{Name}}</title>
    <link rel="stylesheet" href="style.css">
</head>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
    href="https://fonts.googleapis.com/css2?family=Open+Sans:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,300;1,400;1,500;1,600;1,700;1,800&family=Rubik:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
    rel="stylesheet">
<link rel="stylesheet" href="./style.css">

<body id="app">
    <div class="flex flex-col max-w-5xl mx-auto">
        <div class="flex flex-row justify-start gap-1 print:mx-1 max-h-52 bg-white print:border-0
             border border-opacity-30 rounded-xl items-center my-16 print:my-3 drop-shadow-md print:drop-shadow-none">
            {{#if file}}
            <div class="overflow-hidden  rounded-xl max-h-52 print:h-44">
                <img src="{{file}}"
                    class="rounded-full ring-4 ring-offset-2 ring-teal-700 w-96 print:w-80 -ml-12 print:-ml-9 -mt-5" />

            </div>
            {{/if}}
            <div class="flex flex-col gap-4 text-sm w-full print:pl-0 pl-10 print:gap-2 my-4">
                <div>

                <div class="text-teal-700 font-semibold text-2xl">{{Titel}}</div>
                <h2 class="font-extrabold">{{Name}}</h2>
                </div>
                <div class="text-zinc-800">{{calculateAge Geburtstag}} years</div>                
                <div class="flex flex-row mt-4 items-center justify-start gap-5 mr-8 stroke-[1.5] stroke-zinc-800 fill-none
                     text-zinc-800  opacity-75">
                     {{#if Kontakt.Email}}
                    <div class="flex flex-row gap-1 justify-start items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-at" width="16"
                            height="16" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <circle cx="12" cy="12" r="4" />
                            <path d="M16 12v1.5a2.5 2.5 0 0 0 5 0v-1.5a9 9 0 1 0 -5.5 8.28" />
                        </svg>
                        <a href="mailto:{{Kontakt.Email}}" target="_blank" rel="noopener noreferrer">
                            {{Kontakt.Email}}
                        </a>
                    </div>
                    {{/if}}
                    {{#if Kontakt.Telefon}}
                    <div class="flex flex-row gap-1 justify-start items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-phone-call"
                            width="16" height="16" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path
                                d="M5 4h4l2 5l-2.5 1.5a11 11 0 0 0 5 5l1.5 -2.5l5 2v4a2 2 0 0 1 -2 2a16 16 0 0 1 -15 -15a2 2 0 0 1 2 -2" />
                            <path d="M15 7a2 2 0 0 1 2 2" />
                            <path d="M15 3a6 6 0 0 1 6 6" />
                        </svg>
                        <a href="tel:{{Kontakt.Telefon}}" target="_blank" rel="noopener noreferrer">
                            {{Kontakt.Telefon}}
                        </a>
                    </div>
                    {{/if}}
                    {{#if Kontakt.LinkedIn}}
                    <div class="flex flex-row gap-1 justify-start items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-brand-linkedin"
                            width="16" height="16" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <rect x="4" y="4" width="16" height="16" rx="2" />
                            <line x1="8" y1="11" x2="8" y2="16" />
                            <line x1="8" y1="8" x2="8" y2="8.01" />
                            <line x1="12" y1="16" x2="12" y2="11" />
                            <path d="M16 16v-3a2 2 0 0 0 -4 0" />
                        </svg>
                        <a href="{{Kontakt.LinkedIn}}" target="_blank" rel="noopener noreferrer">
                            LinkedIn</a>
                    </div>
                    {{/if}}
                    {{#if Kontakt.Website}}
                    <div class="flex flex-row gap-1 justify-start items-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-link" width="16"
                            height="16" viewBox="0 0 24 24" stroke-linecap="round" stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none" />
                            <path d="M10 14a3.5 3.5 0 0 0 5 0l4 -4a3.5 3.5 0 0 0 -5 -5l-.5 .5" />
                            <path d="M14 10a3.5 3.5 0 0 0 -5 0l-4 4a3.5 3.5 0 0 0 5 5l.5 -.5" />
                        </svg>
                        <a href="{{Kontakt.Website}}" target="_blank" rel="noopener noreferrer">
                            {{Kontakt.Website}}</a>
                    </div>
                    {{/if}}
                </div>




            </div>
        </div>
        <h3 class="container whitespace-nowrap mx-auto mt-8 mb-5 max-w-5xl flex flex-row gap-3 items-baseline self-stretch 
    after:bg-gradient-to-r after:from-teal-200 after:to-teal-800 font-extrabold after:w-full after:h-1 after:content-['']">
            Work experience
        </h3>

        <div class="container mx-auto max-w-5xl">
            {{#each Berufserfahrung}}
            <div class="break-inside-avoid">
                <div class="text-zinc-700 opacity-75 mb-1 mt-8 ml-1">| {{#unless Ende}}since {{/unless}}{{toLocaleDate "en" Start}}
                    {{#if
                    Ende}}to
                    {{toLocaleDate "en" Ende}}{{/if}}</div>
                <div class="font-bold text-lg">{{Position}}</div>
                <div class="text-teal-700 mb-1">{{Firma}} &#8226; {{Ort}}</div>
                <h4 class="my-3"></h4>
                <ul class="list-disc list-outside ml-5">
                    {{#each Aufgaben}}
                    <li class="leading-6">
                        {{this}}
                    </li>
                    {{/each}}
                </ul>
            </div>
            {{/each}}
        </div>
        <h3 class="break-before-page container whitespace-nowrap mx-auto mt-8 mb-5 max-w-5xl flex flex-row gap-3 items-baseline self-stretch 
            after:bg-gradient-to-r after:from-teal-200 after:to-teal-800 font-extrabold after:w-full after:h-1 after:content-['']">
            Education
        </h3>

        <div class="container mx-auto max-w-5xl">
            {{#each Ausbildung}}
            <div class="break-inside-avoid">
                <div class="text-neutral-700 opacity-75 mb-1 mt-8 ml-1">| {{#unless
                    Ende}}since {{/unless}}{{toLocaleDate "en" Start}} {{#if
                    Ende}}to
                    {{toLocaleDate "en" Ende}}{{/if}}</div>
                <div class="flex flex-row items-baseline justify-between">
                    <div class="font-bold text-lg">{{Ausbildung}}</div>
                    <div class="italic">{{#if Abschlussnote}}<span
                            class="text-xs opacity-50 mr-2">Final grade:</span>{{Abschlussnote}}{{else}}Without degree{{/if}}
                    </div>
                </div>
                <div class="text-teal-700 mb-1">{{Ausbildungsstätte}} &#8226; {{Ort}}</div>

                <h4 class="my-3"></h4>
                <ul class="list-disc list-outside ml-5">
                    {{#each Inhalte}}
                    <li class="leading-6">
                        {{this}}
                    </li>
                    {{/each}}
                </ul>
            </div>
            {{/each}}
        </div>

        <div class="break-before-page">
        <h3 class="container whitespace-nowrap mx-auto mt-8 mb-5 max-w-5xl flex flex-row gap-3 items-baseline self-stretch 
            after:bg-gradient-to-r after:from-teal-200 after:to-teal-800 font-extrabold after:w-full after:h-1 after:content-['']">
            Knowledge &amp; skills
        </h3>
                <div class="text-sm text-zinc-700 opacity-80 italic">
                    This is only a selection of my knowledge and skills. Feel free to contact me for further information.
                </div>
        <div class="container mx-auto max-w-5xl mt-8 flex flex-col gap-1 stroke-[1.5] stroke-teal-700 text-sm">
            {{#each Kenntnisse}}
            <div class="font-bold text-lg">{{@key}}</div>
            <div class="grid mb-5 grid-cols-4 print:grid-cols-3 gap-1 items-center break-inside-avoid">
                {{#each this}}
                <div class="grid grid-cols-2 justify-start gap-1 items-center">
                    <div>{{@key}}</div>
                    <div class="flex flex-row gap-0">
                        {{#repeat this}}
                        <div class="fill-teal-700">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-star-filled" width="16" height="16"
                            viewBox="0 0 24 24" stroke-linecap="round"
                            stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path
                                d="M8.243 7.34l-6.38 .925l-.113 .023a1 1 0 0 0 -.44 1.684l4.622 4.499l-1.09 6.355l-.013 .11a1 1 0 0 0 1.464 .944l5.706 -3l5.693 3l.1 .046a1 1 0 0 0 1.352 -1.1l-1.091 -6.355l4.624 -4.5l.078 -.085a1 1 0 0 0 -.633 -1.62l-6.38 -.926l-2.852 -5.78a1 1 0 0 0 -1.794 0l-2.853 5.78z"
                                stroke-width="0"></path>
                        </svg>
                        </div>
                        {{/repeat}}
                        {{#repeat (subtract 5 this)}}
                        <div class="fill-none opacity-25 stroke-2">
                        <svg xmlns="http://www.w3.org/2000/svg" class="icon icon-tabler icon-tabler-star-off" width="16" height="16"
                            viewBox="0 0 24 24"  stroke-linecap="round"
                            stroke-linejoin="round">
                            <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
                            <path d="M3 3l18 18"></path>
                            <path
                                d="M10.012 6.016l1.981 -4.014l3.086 6.253l6.9 1l-4.421 4.304m.012 4.01l.588 3.426l-6.158 -3.245l-6.172 3.245l1.179 -6.873l-5 -4.867l6.327 -.917">
                            </path>
                        </svg>
                        </div>
                        {{/repeat}}
                    </div>
                </div>
                {{/each}}
            </div>
            {{/each}}
        </div>
        </div>
        <div class="break-before-page">
        <h3 class="container whitespace-nowrap mx-auto mt-8 mb-5 max-w-5xl flex flex-row gap-3 items-baseline self-stretch 
            after:bg-gradient-to-r after:from-teal-200 after:to-teal-800 font-extrabold after:w-full after:h-1 after:content-['']">
            Projects
        </h3>
        <div class="container mx-auto max-w-5xl">
            {{#each Projekte}}
            <div class="break-inside-avoid">
                <div class="text-neutral-700 opacity-75 mb-1 mt-8 ml-1">| {{#unless
                    Ende}}since {{/unless}}{{toLocaleDate "en" Start}} {{#if
                    Ende}}to
                    {{toLocaleDate "en" Ende}}{{/if}}</div>
                <div class="font-bold text-lg">{{Name}}</div>
                <div class="text-teal-700 mb-1">{{Kunde}}</div>
                <div class="flex flex-row gap-1 flex-wrap">
                    {{#each Kenntnisse}}
                    <div class="whitespace-nowrap inline-flex rounded-md font-semibold text-white bg-teal-800 
                                        bg-opacity-70
                                        outline outline-1 py-1 px-2 text-xs">
                        {{this}}
                        
                    </div>
                    {{/each}}
                </div>
                <div class="inline-flex">
                    <div>
                        
                    {{markdown Beschreibung}}
                    </div>
                    {{#if Bild}}
                    <img src="{{Bild}}" class="rounded-2xl ml-3 mt-3 max-w-xs max-h-80 inline float-right" alt="Bild zu {{Name}}" />
                    {{/if}}
                </div>
            </div>
            {{/each}}
        </div>
        </div>
        <div class="w-full pt-3 border-t border-zinc-900 border-opacity-70 print:opacity-70 hidden print:flex print:flex-row print:fixed print:bottom-0
         justify-between">
            <div class="flex flex-col" style="font-size: 7pt;">
            <div class="text-teal-800">{{Name}}</div>
            <div>{{Titel}}</div>
            <div>{{Kontakt.Email}}</div>
            </div>
            <div>
                <svg width="32mm" height="11mm" viewBox="0 0 32 11" version="1.1" xmlns:svg="http://www.w3.org/2000/svg">
                    <path d="M 7.830311,0.46006236 H 4.2523863 L 3.211061,2.9968584 c 2.6244205,0 5.2488557,0 7.873286,0 l 0.612702,1.0612525 2.04999,-1.5228564 -1.198112,-2.07519214 z M 20.859946,4.137141 18.984783,5.5302472 16.847897,10.812329 h 10.939314 c 0.875753,0 1.676025,-0.590159 2.007436,-1.416386 l 1.03011,-2.5314565 C 31.154831,6.0410766 30.696345,5.1920166 29.780561,5.1920166 h -0.225984 c 0.698257,0 1.360332,-0.504895 1.617453,-1.1302035 l 0.679726,-1.7025646 c 0.430609,-1.0428643 -0.124411,-2.0944752 -1.289311,-2.0944752 -3.562757,0 -7.125662,0 -10.688418,0 L 19.905739,0.1876705 5.6031062,10.812329 H 9.8571529 L 13.873805,7.8286107 15.566138,10.759539 16.783381,7.7942089 15.923794,6.3056117 20.749612,2.7207594 h 7.366621 c 0.229838,0 0.344307,0.2072955 0.26038,0.4220102 L 28.096065,3.850958 c -0.08927,0.1908395 -0.224352,0.286183 -0.405102,0.286183 -2.277011,0 -4.554021,0 -6.831031,0 z m 0.755944,3.1355596 1.381242,-1.0259559 h 4.48833 c 0.23621,0 0.326367,0.2151523 0.245257,0.4218627 L 27.172882,8.0700129 C 27.106752,8.2251133 26.927625,8.356196 26.767627,8.356196 H 21.177566 Z M 2.6048438,10.812329 H 3.5809499 L 4.991461,7.3760533 H 7.230515 L 10.357771,5.0529297 H 2.367075 L 0.00296467,10.812329 H 2.6048438" style="fill:#008080;fill-opacity:1;fill-rule:evenodd;stroke:none;stroke-width:0.014828" />
                </svg>
            </div>
        </div>
</body>

</html>